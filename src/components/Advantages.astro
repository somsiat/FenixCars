---
import { advantages } from '../data/content';
---

<section class="fx-section fx-section--alt" id="dlaczego-my" aria-labelledby="dlaczego-my-title">
  <div class="fx-container">
    <p class="fx-eyebrow">Dlaczego warto podjąć z nami współpracę</p>
    <h2 id="dlaczego-my-title">Bezpieczeństwo, jasne zasady i dobry kontakt</h2>
    <p class="fx-lead">
      Nie szukamy najdroższego auta. Szukamy auta, które ma sens - poza satysfakcją
      matematyka też musi się zgadzać.
    </p>

    <ul class="adv-list">
      {
        advantages.map((item) => (
          <li>
            <details class="adv">
              <summary class="adv__summary">
                <h3 class="adv__title">{item.title}</h3>
                <span class="adv__marker" aria-hidden="true"></span>
              </summary>
              <p class="adv__body" set:html={item.body} />
            </details>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .adv-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-top: 2.5rem;
  }

  .adv {
    border: 1px solid var(--fx-border);
    border-radius: var(--fx-radius);
    background-color: var(--fx-card);
    box-shadow: var(--fx-shadow-sm);
    transition: border-color 0.2s ease;
  }

  .adv[open] {
    border-color: var(--fx-gold-soft);
  }

  .adv__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.0625rem 1.25rem;
    cursor: pointer;
    list-style: none;
  }

  .adv__summary::-webkit-details-marker {
    display: none;
  }

  .adv__title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .adv__marker {
    position: relative;
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
  }

  .adv__marker::before,
  .adv__marker::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background-color: var(--fx-gold-deep);
    transform: translateY(-50%);
    transition:
      transform 0.22s ease,
      opacity 0.22s ease;
  }

  .adv__marker::after {
    transform: translateY(-50%) rotate(90deg);
  }

  .adv[open] .adv__marker::after {
    transform: translateY(-50%) rotate(0deg);
    opacity: 0;
  }

  .adv__body {
    padding: 0 1.25rem 1.25rem;
    color: var(--fx-ink-2);
    font-size: 0.9375rem;
  }

  .adv__body :global(strong) {
    color: var(--fx-ink);
    font-weight: 800;
  }

  /* Od tabletu w górę: pełne karty jak wcześniej, bez zwijania. */
  @media (min-width: 40rem) {
    .adv-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }

    .adv {
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
      padding: 1.5rem;
      height: 100%;
    }

    .adv[open] {
      border-color: var(--fx-border);
    }

    .adv:hover {
      border-color: var(--fx-gold-soft);
      box-shadow: var(--fx-shadow);
      transform: translateY(-2px);
    }

    .adv__summary {
      padding: 0;
      cursor: default;
      pointer-events: none;
    }

    .adv__marker {
      display: none;
    }

    .adv__title {
      font-size: 1.125rem;
      font-weight: 700;
    }

    .adv__body {
      padding: 0;
      display: block !important;
    }
  }

  @media (min-width: 64rem) {
    .adv-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script>
  const mq = window.matchMedia('(min-width: 40rem)');

  function syncAdvantages(open) {
    document.querySelectorAll('#dlaczego-my details.adv').forEach((el) => {
      el.open = open;
    });
  }

  syncAdvantages(mq.matches);
  mq.addEventListener('change', (e) => syncAdvantages(e.matches));
</script>
