---
import { Image } from 'astro:assets';
import whatsappLogo from '../assets/whatsapp-logo.png';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { company, WA_GROUP_PITCH } from '../data/company';

interface Props {
  /** „band” — pasek na jasnym tle, „panel” — wariant na ciemnym tle sekcji. */
  variant?: 'band' | 'panel';
}

const { variant = 'band' } = Astro.props;
---

<section class:list={['wa', `wa--${variant}`]} aria-labelledby="wa-title">
  <div class="fx-container">
    <div class="wa__card">
      <div class="wa__body">
        <p class="wa__label">
          <Image src={whatsappLogo} alt="" width={20} densities={[1, 2]} class="wa__label-icon" />
          Grupa WhatsApp
        </p>
        <h2 id="wa-title" class="wa__title">Codzienna selekcja aut z USA i Kanady</h2>
        <p class="wa__text">{WA_GROUP_PITCH}</p>
      </div>

      <div class="wa__action">
        <a
          class="fx-btn fx-btn--whatsapp fx-btn--lg fx-btn--block"
          href={company.links.whatsappGroup}
          target="_blank"
          rel="noopener"
        >
          <WhatsAppIcon />
          Dołącz do grupy
        </a>
        <p class="wa__note">Bezpłatnie i bez zobowiązań - wyjdziesz, kiedy chcesz.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .wa--band {
    padding-block: 2.5rem;
    background-color: #f1faf3;
  }

  .wa--panel {
    padding-block: var(--fx-section-y);
    background-color: var(--fx-bg);
  }

  .wa__card {
    display: grid;
    gap: 1.5rem;
    padding: 1.5rem;
    border: 1px solid #cfe9d8;
    /* Zielony pas z lewej dodatkowo wyróżnia blok na tle reszty strony. */
    border-left: 4px solid var(--fx-whatsapp);
    border-radius: var(--fx-radius);
    background-color: var(--fx-bg);
    box-shadow: var(--fx-shadow);
  }

  .wa__label {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    margin-bottom: 0.625rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fx-whatsapp-dark);
  }

  .wa__label-icon {
    width: 1rem;
    height: 1rem;
  }

  .wa__title {
    font-size: clamp(1.375rem, 4vw, 1.875rem);
  }

  .wa__text {
    max-width: 58ch;
    margin-top: 0.625rem;
    color: var(--fx-ink-2);
  }

  .wa__action {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .wa__note {
    font-size: 0.8125rem;
    text-align: center;
    color: var(--fx-ink-3);
  }

  @media (min-width: 56rem) {
    .wa__card {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 2.5rem;
      padding: 2rem 2.25rem;
    }

    .wa__action {
      min-width: 17rem;
    }
  }
</style>
