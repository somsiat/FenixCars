---
import { homeProcessSteps, processSteps } from '../data/content';

interface Props {
  /**
   * „summary” — trzy etapy na stronie głównej,
   * „full” — pełne rozwinięcie na podstronie.
   */
  variant?: 'summary' | 'full';
}

const { variant = 'summary' } = Astro.props;
const isFull = variant === 'full';
const steps = isFull ? processSteps : homeProcessSteps;
---

<section
  class:list={['fx-section', { 'fx-section--warm': !isFull }]}
  id="przebieg"
  aria-labelledby="przebieg-title"
>
  <div class="fx-container">
    {
      !isFull && (
        <>
          <p class="fx-eyebrow">Przebieg sprowadzania auta</p>
          <h2 id="przebieg-title">Jak wygląda import auta</h2>
          <p class="fx-lead">
            Najważniejsze etapy w skrócie: wybór auta, weryfikacja i licytacja, potem
            transport, odprawa i samochód pod dom. Szczegółowy opis każdego etapu importu
            auta znajduje się poniżej
          </p>
        </>
      )
    }
    {
      isFull && (
        <>
          <h2 id="przebieg-title" class="fx-sr-only">Cały proces krok po kroku</h2>
          <p class="fx-lead">
            Poniżej opisujemy sprowadzanie aut z USA i z Kanady: co dzieje się na każdym etapie
            i za co odpowiadamy. Na każdym kroku informujemy Cię o statusie pojazdu.
          </p>
        </>
      )
    }

    <ol class:list={['steps', { 'steps--full': isFull }]}>
      {
        steps.map((step, index) => (
          <li class="step">
            <div class="step__num" aria-hidden="true">{index + 1}</div>
            <div class="step__content">
              <h3 class="step__title">{step.title}</h3>
              {
                isFull && 'detail' in step ? (
                  step.detail.map((paragraph) => <p class="step__text">{paragraph}</p>)
                ) : (
                  <p class="step__text">{step.summary}</p>
                )
              }
            </div>
          </li>
        ))
      }
    </ol>

    {
      !isFull && (
        <p class="steps__more">
          <a class="fx-link" href="/jak-sprowadzamy-auto">
            Kliknij tutaj, by poznać szczegółowy opis każdego etapu
            <span aria-hidden="true">→</span>
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 2.5rem;
    counter-reset: step;
  }

  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--fx-border);
    border-radius: var(--fx-radius);
    background-color: var(--fx-card);
    box-shadow: var(--fx-shadow-sm);
  }

  .step__num {
    display: grid;
    place-items: center;
    width: 2.375rem;
    height: 2.375rem;
    border-radius: var(--fx-radius-sm);
    background: var(--fx-gold-gradient);
    color: #1a1305;
    font-family: var(--fx-font-display);
    font-size: 1.125rem;
    font-weight: 600;
  }

  .step__title {
    font-size: 1.0625rem;
  }

  .step__text {
    margin-top: 0.5rem;
    color: var(--fx-ink-2);
    font-size: 0.9375rem;
  }

  .step__text + .step__text {
    margin-top: 0.75rem;
  }

  .steps__more {
    margin-top: 1.75rem;
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }

    /* Wersja pełna czyta się lepiej w jednej kolumnie. */
    .steps--full {
      grid-template-columns: 1fr;
      max-width: 52rem;
    }

    .steps--full .step {
      padding: 1.75rem;
    }
  }

  @media (min-width: 64rem) {
    .steps:not(.steps--full) {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
