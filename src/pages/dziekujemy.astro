---
import Layout from '../layouts/Layout.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { primaryContact, waLink, DEFAULT_WA_MESSAGE } from '../data/company';

const title = 'Dziękujemy za zapytanie | Fenix Cars';
const description = 'Dziękujemy za wysłanie zapytania o wycenę importu auta z USA lub Kanady.';
---

<Layout title={title} description={description} path="/dziekujemy" noindex>
  <section class="fx-section thanks">
    <div class="fx-container thanks__inner">
      <p class="fx-eyebrow">Zapytanie wysłane</p>
      <h1>Dziękujemy za Twój czas! Wkrótce się odezwiemy.</h1>
      <p class="fx-lead">
        W międzyczasie możesz napisać do nas bezpośrednio na WhatsAppie - czasem to
        najszybsza droga, żeby dogadać szczegóły.
      </p>

      <div class="thanks__actions">
        <a
          class="fx-btn fx-btn--whatsapp fx-btn--lg"
          href={waLink(primaryContact.phone, DEFAULT_WA_MESSAGE)}
          target="_blank"
          rel="noopener"
        >
          <WhatsAppIcon />
          Napisz na WhatsApp
        </a>
        <a class="fx-btn fx-btn--outline fx-btn--lg" href="/">Wróć na stronę główną</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .thanks {
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .thanks__inner {
    max-width: 42rem;
  }

  .thanks__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  @media (min-width: 40rem) {
    .thanks__actions {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }
  }
</style>
