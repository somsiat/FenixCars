---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import WhatsAppGroup from '../components/WhatsAppGroup.astro';
import Contact from '../components/Contact.astro';
import { company } from '../data/company';

const title = 'Galeria - auta sprowadzone z USA i Kanady | Fenix Cars';
const description =
  'Zdjęcia aut sprowadzonych przez Fenix Cars z USA i Kanady dla naszych klientów. Rzeszów, Podkarpacie, dostawa w całej Polsce.';

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/galeria/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP}',
  { eager: true }
);

const photos = Object.entries(imageModules)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, mod], index) => ({
    src: mod.default,
    alt: `Samochód sprowadzony z USA lub Kanady przez Fenix Cars (${index + 1})`,
  }));
---

<Layout
  title={title}
  description={description}
  path="/galeria"
>
  <section class="fx-section gal">
    <div class="fx-container">
      <nav class="crumbs" aria-label="Okruszki">
        <a href="/">Strona główna</a>
        <span aria-hidden="true">/</span>
        <span>Galeria</span>
      </nav>
      <p class="fx-eyebrow">Nasze ostatnie projekty</p>
      <h1>Auta z USA i Kanady, które już sprowadziliśmy</h1>
      <p class="fx-lead">
        Samochody z USA i Kanady, które sprowadziliśmy dla naszych klientów pod wskazany adres —
        w tym realizacje dla osób z Rzeszowa i z innych regionów Polski.
      </p>

      {
        photos.length > 0 && (
          <ul class="gal__grid" data-gal-grid>
            {photos.map((photo, index) => (
              <li class="gal__item">
                <button
                  type="button"
                  class="gal__thumb"
                  data-gal-open={index}
                  data-full-src={photo.src.src}
                  data-full-alt={photo.alt}
                  aria-label={`Powiększ zdjęcie ${index + 1} z ${photos.length}`}
                >
                  <Image
                    src={photo.src}
                    alt={photo.alt}
                    width={800}
                    densities={[1, 1.5]}
                    loading={index < 4 ? 'eager' : 'lazy'}
                  />
                </button>
              </li>
            ))}
          </ul>
        )
      }

      <p class="gal__more">
        <a
          class="fx-btn fx-btn--dark"
          href={company.links.googleReviews}
          target="_blank"
          rel="noopener"
        >
          Zobacz zdjęcia na wizytówce Google
        </a>
      </p>
    </div>
  </section>

  <dialog class="gal__lightbox" data-gal-lightbox aria-label="Powiększone zdjęcie">
    <img class="gal__lightbox-img" data-gal-img alt="" />
    <button class="gal__btn gal__btn--close" type="button" data-gal-close aria-label="Zamknij">
      ×
    </button>
    <button class="gal__btn gal__btn--prev" type="button" data-gal-prev aria-label="Poprzednie zdjęcie">
      ‹
    </button>
    <button class="gal__btn gal__btn--next" type="button" data-gal-next aria-label="Następne zdjęcie">
      ›
    </button>
    <p class="gal__lightbox-credit" aria-live="polite" data-gal-caption></p>
  </dialog>

  <WhatsAppGroup variant="panel" />
  <Contact />
</Layout>

<script>
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('[data-gal-open]')];
  const lightbox = document.querySelector<HTMLDialogElement>('[data-gal-lightbox]');
  const lightboxImg = lightbox?.querySelector<HTMLImageElement>('[data-gal-img]');
  const caption = lightbox?.querySelector<HTMLElement>('[data-gal-caption]');

  let current = 0;

  function show(index: number) {
    if (!lightbox || !lightboxImg || !caption || !thumbs.length) return;
    current = (index + thumbs.length) % thumbs.length;
    const btn = thumbs[current];
    lightboxImg.src = btn.dataset.fullSrc ?? '';
    lightboxImg.alt = btn.dataset.fullAlt ?? '';
    caption.textContent = `Zdjęcie ${current + 1} z ${thumbs.length}`;
    if (!lightbox.open) lightbox.showModal();
  }

  thumbs.forEach((btn, index) => {
    btn.addEventListener('click', () => show(index));
  });

  lightbox?.querySelector('[data-gal-close]')?.addEventListener('click', () => lightbox.close());
  lightbox?.querySelector('[data-gal-prev]')?.addEventListener('click', () => show(current - 1));
  lightbox?.querySelector('[data-gal-next]')?.addEventListener('click', () => show(current + 1));

  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) lightbox.close();
  });

  lightbox?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') show(current - 1);
    if (event.key === 'ArrowRight') show(current + 1);
  });

  let touchX: number | null = null;
  lightbox?.addEventListener(
    'touchstart',
    (event) => {
      touchX = event.touches[0]?.clientX ?? null;
    },
    { passive: true }
  );
  lightbox?.addEventListener(
    'touchend',
    (event) => {
      if (touchX === null) return;
      const delta = (event.changedTouches[0]?.clientX ?? touchX) - touchX;
      if (Math.abs(delta) > 40) show(current + (delta < 0 ? 1 : -1));
      touchX = null;
    },
    { passive: true }
  );
</script>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    color: var(--fx-ink-3);
  }

  .crumbs a:hover {
    color: var(--fx-gold-deep);
  }

  .gal h1 {
    margin-top: 0.5rem;
  }

  .gal__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .gal__item {
    min-width: 0;
  }

  .gal__thumb {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    padding: 0;
    border: 1px solid var(--fx-border);
    border-radius: var(--fx-radius);
    background-color: var(--fx-bg-alt);
    aspect-ratio: 4 / 3;
    cursor: zoom-in;
  }

  .gal__thumb :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.3s ease;
  }

  .gal__thumb:hover :global(img) {
    transform: scale(1.03);
  }

  .gal__more {
    margin-top: 2rem;
  }

  .gal__lightbox {
    width: min(94vw, 80rem);
    max-height: 94vh;
    padding: 0;
    border: 0;
    border-radius: var(--fx-radius);
    background: var(--fx-dark);
    color: var(--fx-on-dark-2);
  }

  .gal__lightbox::backdrop {
    background: rgba(12, 11, 10, 0.88);
  }

  .gal__lightbox-img {
    display: block;
    max-width: 100%;
    max-height: calc(94vh - 3rem);
    margin-inline: auto;
    object-fit: contain;
  }

  .gal__lightbox-credit {
    padding: 0.75rem 1rem;
    font-size: 0.8125rem;
  }

  .gal__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 999px;
    background: rgba(12, 11, 10, 0.7);
    color: #fff;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
  }

  .gal__btn:hover {
    background: rgba(12, 11, 10, 0.9);
    color: var(--fx-gold-soft);
  }

  .gal__btn--close {
    top: 0.5rem;
    right: 0.5rem;
  }

  .gal__btn--prev,
  .gal__btn--next {
    top: calc(50% - 1.5rem);
  }

  .gal__btn--prev {
    left: 0.5rem;
  }

  .gal__btn--next {
    right: 0.5rem;
  }

  @media (min-width: 48rem) {
    .gal__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  @media (min-width: 64rem) {
    .gal__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
</style>